{
  "name": "video-subtitle-extension",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "apps/extension"
  ],
  "scripts": {
    "build": "npm run build --workspace @video-subtitle/extension",
    "typecheck": "npm run typecheck --workspace @video-subtitle/extension",
    "runtime:fetch": "node scripts/fetch-wasm-runtime.mjs",
    "test:browser": "node scripts/serve-tests.mjs",
    "test:segmenter": "node --experimental-strip-types --test tests/sentence-segmenter.test.mjs",
    "test:punctuation": "node --experimental-strip-types --test tests/punctuation-engine.test.mjs",
    "verify": "npm run typecheck && npm run test:segmenter && npm run test:punctuation && npm run build"
  }
}

