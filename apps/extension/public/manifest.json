{
  "manifest_version": 3,
  "name": "视频实时中文字幕",
  "version": "3.0.0",
  "description": "捕获网页视频音频，在本地自动生成简体中文字幕",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开实时中文字幕",
    "default_icon": "icons/icon16.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture",
    "tabs"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; media-src 'self'; connect-src 'self'; worker-src 'self';"
  }
}

